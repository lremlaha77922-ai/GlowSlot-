{
  "appId": "com.glowslot.app",
  "appName": "GlowSlot",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#121212",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
